{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "PCYES V3 Design Tokens — DTCG format. Compatible with Tokens Studio for Figma + Style Dictionary. Last sync: 2026-05-28.",
  "$source": "src/styles/theme.css",

  "color": {
    "$description": "Cores semânticas — modos light/dark via Figma Variable modes",

    "background": {
      "light": { "$value": "#fafafa", "$type": "color" },
      "dark":  { "$value": "#121212", "$type": "color" }
    },
    "foreground": {
      "light": { "$value": "#161616", "$type": "color" },
      "dark":  { "$value": "#ffffff", "$type": "color" }
    },
    "card": {
      "light": { "$value": "#ffffff", "$type": "color" },
      "dark":  { "$value": "rgba(26, 26, 26, 0.90)", "$type": "color" }
    },
    "primary": {
      "light": { "$value": "#dc1414", "$type": "color" },
      "dark":  { "$value": "#ff2b2e", "$type": "color" }
    },
    "primary-foreground": {
      "$value": "#ffffff", "$type": "color"
    },
    "secondary": {
      "light": { "$value": "#f5f5f5", "$type": "color" },
      "dark":  { "$value": "#cecece", "$type": "color" }
    },
    "muted": {
      "light": { "$value": "#8c8c8c", "$type": "color" },
      "dark":  { "$value": "#808080", "$type": "color" }
    },
    "muted-foreground": {
      "light": { "$value": "#646464", "$type": "color" },
      "dark":  { "$value": "#ffffff", "$type": "color" }
    },
    "accent": {
      "light": { "$value": "#dc1414", "$type": "color" },
      "dark":  { "$value": "#ff5558", "$type": "color" }
    },
    "destructive": {
      "light": { "$value": "#dc3232", "$type": "color" },
      "dark":  { "$value": "#f64c4c", "$type": "color" }
    },
    "border": {
      "light": { "$value": "#dcdcdc", "$type": "color" },
      "dark":  { "$value": "#808080", "$type": "color" }
    },

    "brand-red": {
      "$description": "Vermelhos especiais — uso em gradients + hover glow alpha",
      "base":      { "$value": "#dc1414", "$type": "color" },
      "dark-base": { "$value": "#ff2b2e", "$type": "color" },
      "glow":      { "$value": "#ff2419", "$type": "color" },
      "discount-light": { "$value": "#ff3b3e", "$type": "color" },
      "discount-dark":  { "$value": "#d31417", "$type": "color" },
      "preorder-deep":  { "$value": "#b91c1c", "$type": "color" },
      "glow-alpha-base": { "$value": "rgba(225, 6, 0, 1)", "$type": "color", "$description": "Use com alpha 0.08/0.10/0.12/0.18/0.22/0.28/0.35/0.45/0.55" }
    },

    "buy-green": {
      "light":     { "$value": "#22c55e", "$type": "color" },
      "dark-base": { "$value": "#16a34a", "$type": "color" },
      "novelty":   { "$value": "#34d399", "$type": "color" }
    },

    "preorder-orange": {
      "light":     { "$value": "#f97316", "$type": "color" },
      "dark-base": { "$value": "#ea580c", "$type": "color" }
    },

    "coin": {
      "$description": "PCYES Coin asset colors",
      "gold-light":  { "$value": "#fde68a", "$type": "color" },
      "gold-mid":    { "$value": "#facc15", "$type": "color" },
      "gold-dark":   { "$value": "#b45309", "$type": "color" },
      "bronze":      { "$value": "#92400e", "$type": "color" },
      "letter":      { "$value": "#7c2d12", "$type": "color" }
    },

    "surface-dark-ladder": {
      "$description": "Surfaces dark hardcoded — em ordem do mais escuro pro mais claro",
      "0":   { "$value": "#040404", "$type": "color" },
      "0a":  { "$value": "#0a0a0a", "$type": "color", "$description": "Background de seção (default)" },
      "0e":  { "$value": "#0e0e0e", "$type": "color", "$description": "ProductShelf section bg" },
      "1a":  { "$value": "#1a1a1a", "$type": "color", "$description": "Card surface" },
      "1f":  { "$value": "#1f1c1c", "$type": "color", "$description": "Navbar search input" },
      "32":  { "$value": "#323232", "$type": "color", "$description": "Surface elevada (raro)" }
    }
  },

  "radius": {
    "$description": "Radii — formatos formais",
    "base":        { "$value": "4px",    "$type": "dimension" },
    "button":      { "$value": "4px",    "$type": "dimension" },
    "card":        { "$value": "8px",    "$type": "dimension" },
    "card-sm":     { "$value": "12px",   "$type": "dimension", "$description": "Modal central, countdown cells, search input" },
    "card-md":     { "$value": "18px",   "$type": "dimension", "$description": "Brinde card, cards intermediários" },
    "card-lg":     { "$value": "22px",   "$type": "dimension", "$description": "Product card image well, cart drawer, welcome popup" },
    "card-xl":     { "$value": "26px",   "$type": "dimension", "$description": "CategoryShowcase, Drop-do-Dia, mega-menu showcase" },
    "pill":        { "$value": "9999px", "$type": "dimension", "$description": "CTAs, search input, badges, ícones circulares" }
  },

  "spacing": {
    "$description": "Section vertical padding — escala fluida desktop/mobile",
    "section-sm-desktop": { "$value": "56px",  "$type": "dimension" },
    "section-md-desktop": { "$value": "88px",  "$type": "dimension" },
    "section-lg-desktop": { "$value": "128px", "$type": "dimension" },
    "section-xl-desktop": { "$value": "168px", "$type": "dimension" },
    "section-sm-mobile":  { "$value": "40px",  "$type": "dimension" },
    "section-md-mobile":  { "$value": "56px",  "$type": "dimension" },
    "section-lg-mobile":  { "$value": "72px",  "$type": "dimension" },
    "section-xl-mobile":  { "$value": "96px",  "$type": "dimension" },
    "page-padding-mobile":  { "$value": "20px", "$type": "dimension" },
    "page-padding-desktop": { "$value": "72px", "$type": "dimension" }
  },

  "size": {
    "$description": "Layout container caps",
    "container-shelf":      { "$value": "1600px", "$type": "dimension" },
    "container-band":       { "$value": "1760px", "$type": "dimension" },
    "container-trust":      { "$value": "1200px", "$type": "dimension" },
    "container-modal-md":   { "$value": "560px",  "$type": "dimension" },
    "container-modal-lg":   { "$value": "640px",  "$type": "dimension" },
    "container-welcome":    { "$value": "920px",  "$type": "dimension" },
    "touch-target-min":     { "$value": "44px",   "$type": "dimension", "$description": "Mobile touch target (iOS HIG)" }
  },

  "typography": {
    "$description": "Token semântico (h1-h4, base, sm, xs, label, caption, micro). Note: maior parte dos componentes usa clamp() inline, não estes tokens.",

    "fontFamily": {
      "display": { "$value": "Figtree", "$type": "fontFamily", "$description": "Headings" },
      "body":    { "$value": "Inter",   "$type": "fontFamily", "$description": "UI / body / inputs" }
    },

    "fontWeight": {
      "light":    { "$value": 300, "$type": "fontWeight" },
      "normal":   { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" },
      "extrabold":{ "$value": 800, "$type": "fontWeight" },
      "black":    { "$value": 900, "$type": "fontWeight" }
    },

    "fontSize": {
      "$description": "Escala semântica",
      "h1":      { "$value": "80px", "$type": "dimension" },
      "h2":      { "$value": "48px", "$type": "dimension" },
      "h3":      { "$value": "40px", "$type": "dimension" },
      "h4":      { "$value": "32px", "$type": "dimension" },
      "base":    { "$value": "16px", "$type": "dimension" },
      "sm":      { "$value": "14px", "$type": "dimension" },
      "xs":      { "$value": "13px", "$type": "dimension" },
      "label":   { "$value": "13px", "$type": "dimension" },
      "caption": { "$value": "12px", "$type": "dimension" },
      "micro":   { "$value": "11px", "$type": "dimension" }
    },

    "fontSize-fluid": {
      "$description": "Escala fluida real (clamp) — a usada nos componentes",
      "shelf-title":     { "$value": "clamp(28px, 3vw, 36px)",   "$type": "dimension", "$description": "ProductShelf, DealsHighlight (size=sm)" },
      "deal-title":      { "$value": "clamp(28px, 3vw, 38px)",   "$type": "dimension", "$description": "FlashDealsStrip, DropDoDia (size=md)" },
      "category-title":  { "$value": "clamp(28px, 3.4vw, 44px)", "$type": "dimension", "$description": "CategoryShowcase (size=lg)" },
      "newsletter":      { "$value": "clamp(26px, 7vw, 52px)",   "$type": "dimension", "$description": "Newsletter giant title" },
      "category-display":{ "$value": "clamp(48px, 6vw, 74px)",   "$type": "dimension", "$description": "CategoryGrid display heading" }
    },

    "letterSpacing": {
      "eyebrow":  { "$value": "0.3em",   "$type": "string", "$description": "// LABEL eyebrows" },
      "pill":     { "$value": "0.16em",  "$type": "string", "$description": "Pills uppercase (Inter 10/900)" },
      "pill-tight":{ "$value": "0.12em", "$type": "string", "$description": "BRINDE, progress labels" },
      "form-label":{ "$value": "0.14em", "$type": "string", "$description": "Form labels uppercase" },
      "cta":      { "$value": "0.04em",  "$type": "string", "$description": "Buy/preorder CTAs" },
      "cta-brand":{ "$value": "0.05em",  "$type": "string", "$description": "Brand CTAs uppercase" },
      "title-tight":{ "$value": "-0.02em", "$type": "string", "$description": "Section h2" },
      "title-tighter":{ "$value": "-0.03em", "$type": "string", "$description": "Category display" }
    }
  },

  "shadow": {
    "$description": "Box-shadows — Figma Effects, não Variables. Exporta como referência.",

    "neon-red": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(225, 6, 0, 0.55)", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px" },
        { "color": "rgba(225, 6, 0, 0.10)", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "4px" },
        { "color": "rgba(225, 6, 0, 0.45)", "offsetX": "0", "offsetY": "0", "blur": "22px", "spread": "-2px" },
        { "color": "rgba(225, 6, 0, 0.25)", "offsetX": "0", "offsetY": "0", "blur": "60px", "spread": "-8px" },
        { "color": "rgba(0, 0, 0, 0.60)",   "offsetX": "0", "offsetY": "16px", "blur": "44px", "spread": "-16px" },
        { "color": "rgba(255, 255, 255, 0.10)", "offsetX": "0", "offsetY": "1px", "blur": "0", "spread": "0", "inset": true },
        { "color": "rgba(255, 255, 255, 0.05)", "offsetX": "0", "offsetY": "40px", "blur": "35px", "spread": "-24px", "inset": true }
      ],
      "$description": "Canonical hover de card (.neon-hover-red)"
    },
    "neon-glow-deepen": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(225, 6, 0, 0.18)", "offsetX": "0", "offsetY": "0", "blur": "80px", "spread": "-16px", "inset": true }],
      "$description": "Inner glow children dentro de .neon-hover-red:hover"
    },
    "hero-card-hover": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(0, 0, 0, 0.75)", "offsetX": "0", "offsetY": "30px", "blur": "80px", "spread": "-24px" },
        { "color": "rgba(225, 6, 0, 0.35)", "offsetX": "0", "offsetY": "0", "blur": "50px", "spread": "-10px" }
      ]
    },
    "category-active": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(225, 6, 0, 0.45)", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px" },
        { "color": "rgba(0, 0, 0, 0.70)", "offsetX": "0", "offsetY": "30px", "blur": "80px", "spread": "-20px" },
        { "color": "rgba(225, 6, 0, 0.40)", "offsetX": "0", "offsetY": "0", "blur": "32px", "spread": "-4px" },
        { "color": "rgba(255, 255, 255, 0.06)", "offsetX": "0", "offsetY": "1px", "blur": "0", "spread": "0", "inset": true }
      ]
    },
    "essential-hover": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(225, 6, 0, 0.18)", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px" },
        { "color": "rgba(225, 6, 0, 0.50)", "offsetX": "0", "offsetY": "24px", "blur": "60px", "spread": "-28px" }
      ]
    },
    "deal-hover": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(225, 6, 0, 0.15)", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px" },
        { "color": "rgba(225, 6, 0, 0.45)", "offsetX": "0", "offsetY": "22px", "blur": "50px", "spread": "-28px" }
      ]
    },
    "profile-hover": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(225, 6, 0, 0.12)", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px" },
        { "color": "rgba(225, 6, 0, 0.35)", "offsetX": "0", "offsetY": "18px", "blur": "40px", "spread": "-22px" }
      ]
    },
    "order-hover": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(225, 6, 0, 0.08)", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px" },
        { "color": "rgba(0, 0, 0, 0.50)", "offsetX": "0", "offsetY": "14px", "blur": "30px", "spread": "-20px" }
      ]
    },
    "buy-cta": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(34, 197, 94, 0.55)", "offsetX": "0", "offsetY": "14px", "blur": "32px", "spread": "-8px" }],
      "$description": "Buy CTA principal (Comprar agora)"
    },
    "buy-cta-sm": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(34, 197, 94, 0.55)", "offsetX": "0", "offsetY": "10px", "blur": "26px", "spread": "-6px" }],
      "$description": "Buy quick-add em product card"
    },
    "brand-cta": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(225, 6, 0, 0.55)", "offsetX": "0", "offsetY": "14px", "blur": "32px", "spread": "-8px" }]
    },
    "brand-cta-sm": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(225, 6, 0, 0.55)", "offsetX": "0", "offsetY": "8px", "blur": "22px", "spread": "-8px" }]
    },
    "brand-pill": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(225, 6, 0, 0.55)", "offsetX": "0", "offsetY": "8px", "blur": "22px", "spread": "-6px" }],
      "$description": "Newsletter / brand pills"
    },
    "discount-badge": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(255, 43, 46, 0.55)", "offsetX": "0", "offsetY": "12px", "blur": "28px", "spread": "-8px" }],
      "$description": "-X% pill canônico"
    },
    "discount-sm": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(255, 43, 46, 0.60)", "offsetX": "0", "offsetY": "4px", "blur": "14px", "spread": "-4px" }],
      "$description": "Discount badge pequeno inline em ProductPage"
    },
    "preorder-cta": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(249, 115, 22, 0.55)", "offsetX": "0", "offsetY": "14px", "blur": "32px", "spread": "-8px" }]
    },
    "preorder-pill": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(249, 115, 22, 0.60)", "offsetX": "0", "offsetY": "6px", "blur": "16px", "spread": "-4px" }]
    },
    "drawer-side": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(0, 0, 0, 0.55)", "offsetX": "-24px", "offsetY": "0", "blur": "60px", "spread": "-12px" }],
      "$description": "CartDrawer lateral"
    },
    "search-open": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(0, 0, 0, 0.55)", "offsetX": "0", "offsetY": "10px", "blur": "32px", "spread": "0" }],
      "$description": "Navbar search focused"
    },
    "elevation-sm": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(0, 0, 0, 0.08)", "offsetX": "0", "offsetY": "1px", "blur": "3px", "spread": "0" },
        { "color": "rgba(0, 0, 0, 0.04)", "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0" }
      ],
      "$description": "Generic light elevation (legacy)"
    }
  },

  "gradient": {
    "$description": "Brand gradients — Figma Styles (não Variables). Sempre 135deg exceto category-grid.",

    "brand": {
      "$type": "gradient",
      "$value": {
        "type": "linear",
        "angle": "135deg",
        "stops": [
          { "color": "{color.primary}", "position": 0 },
          { "color": "{color.brand-red.glow}", "position": 1 }
        ]
      },
      "$description": "Newsletter CTA, ranking medallion, brand glow"
    },
    "discount": {
      "$type": "gradient",
      "$value": {
        "type": "linear",
        "angle": "135deg",
        "stops": [
          { "color": "{color.brand-red.discount-light}", "position": 0 },
          { "color": "{color.brand-red.discount-dark}", "position": 1 }
        ]
      },
      "$description": "Pill de desconto -X%"
    },
    "buy": {
      "$type": "gradient",
      "$value": {
        "type": "linear",
        "angle": "135deg",
        "stops": [
          { "color": "{color.buy-green.light}", "position": 0 },
          { "color": "{color.buy-green.dark-base}", "position": 1 }
        ]
      },
      "$description": "Comprar agora / Adicionar ao carrinho"
    },
    "preorder-orange": {
      "$type": "gradient",
      "$value": {
        "type": "linear",
        "angle": "135deg",
        "stops": [
          { "color": "{color.preorder-orange.light}", "position": 0 },
          { "color": "{color.preorder-orange.dark-base}", "position": 1 }
        ]
      },
      "$description": "CTA pré-venda mobile + PreOrderPill"
    },
    "preorder-red": {
      "$type": "gradient",
      "$value": {
        "type": "linear",
        "angle": "135deg",
        "stops": [
          { "color": "{color.brand-red.glow}", "position": 0 },
          { "color": "{color.brand-red.preorder-deep}", "position": 1 }
        ]
      },
      "$description": "Pill pré-venda no card"
    },
    "hero-stroke": {
      "$type": "gradient",
      "$value": {
        "type": "linear",
        "angle": "135deg",
        "stops": [
          { "color": "rgba(255, 255, 255, 0.22)", "position": 0 },
          { "color": "rgba(255, 255, 255, 0.08)", "position": 1 }
        ]
      },
      "$description": "Stroke default do hero card"
    },
    "hero-stroke-hover": {
      "$type": "gradient",
      "$value": {
        "type": "linear",
        "angle": "135deg",
        "stops": [
          { "color": "{color.primary}", "position": 0 },
          { "color": "{color.brand-red.glow}", "position": 0.35 },
          { "color": "rgba(225, 6, 0, 0.55)", "position": 0.65 },
          { "color": "rgba(225, 6, 0, 0.15)", "position": 1 }
        ]
      },
      "$description": "Stroke hover do hero card"
    },
    "category-grid": {
      "$type": "gradient",
      "$value": {
        "type": "linear",
        "angle": "72.85deg",
        "stops": [
          { "color": "#000000", "position": 0.4462 },
          { "color": "#0f0f0f", "position": 1.0035 }
        ]
      },
      "$description": "Background do CategoryGrid"
    }
  },

  "motion": {
    "$description": "Animation timing + easing",
    "easing-house": {
      "$value": "cubic-bezier(0.16, 1, 0.3, 1)",
      "$type": "cubicBezier",
      "$description": "Easing principal da marca — usada em quase toda animação"
    },
    "duration": {
      "fast":   { "$value": "200ms", "$type": "duration" },
      "normal": { "$value": "300ms", "$type": "duration" },
      "hover":  { "$value": "320ms", "$type": "duration" },
      "reveal": { "$value": "500ms", "$type": "duration" },
      "zoom":   { "$value": "700ms", "$type": "duration", "$description": "Image hover zoom em product cards" }
    },
    "stagger-children": { "$value": "40ms", "$type": "duration", "$description": "Delay entre items em shelves" }
  }
}

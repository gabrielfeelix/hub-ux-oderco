      "green-soft":   { "value": "#98DDA4", "type": "color", "description": "Success suave · borders/strokes" },
      "green-softer": { "value": "#CCEED2", "type": "color", "description": "Success BG · pílulas, banners" },
      "yellow":       { "value": "#F39200", "type": "color", "description": "Warning · pendentes, atenção" },

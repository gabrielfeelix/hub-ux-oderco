    "md":   { "value": "0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03)", "type": "shadow", "description": "Padrão · dropdowns, popovers" },
    "lg":   { "value": "0 10px 15px -3px rgba(0,0,0,0.05), 0 4px 6px -2px rgba(0,0,0,0.025)", "type": "shadow", "description": "Grande · modais, overlays principais" },
    "card": { "value": "0 0 16px 0 rgba(0,0,0,0.08)", "type": "shadow", "description": "Card hover · listings interativos" }

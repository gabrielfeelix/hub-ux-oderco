    "format": "Style Dictionary / Tokens Studio compatible"
  },

  "color": {
    "brand": {
      "navy":         { "value": "#0D1D52", "type": "color", "description": "Azul Odex · primário corporativo (sidebar, headings principais)" },
      "blue":         { "value": "#005AFF", "type": "color", "description": "Azul complementar 1 · CTAs primários, links" },
      "blue-button":  { "value": "#22437D", "type": "color", "description": "Azul botão (variante navy escura)" },
      "blue-hover":   { "value": "#0046CC", "type": "color", "description": "Hover do .ds-btn-primary" },
      "navy-hover":   { "value": "#162460", "type": "color", "description": "Hover do .ds-btn-primary-navy" },
      "slate":        { "value": "#5A616F", "type": "color", "description": "Cinza-azulado complementar" },
      "slate-2":      { "value": "#3B537D", "type": "color", "description": "Azul complementar 2 · texto sobre info-bg" },
      "slate-soft":   { "value": "#ABB7CD", "type": "color", "description": "Slate suave · borders sutis" },
      "slate-soft-2": { "value": "#BDC7D8", "type": "color", "description": "Slate ainda mais suave" }
    },

    "text": {
      "ink":         { "value": "#000000", "type": "color", "description": "Text padrão · headings e body principal" },
      "muted":       { "value": "#6E6E6E", "type": "color", "description": "Text complementar · labels secundárias, hints" },

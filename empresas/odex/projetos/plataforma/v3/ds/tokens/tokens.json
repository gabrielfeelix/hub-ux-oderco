{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$meta": {
    "name": "Odex Plataforma Solar · Design Tokens",
    "version": "0.1.0",
    "owner": "Gabriel Felix Barbosa",
    "updated": "2026-05-20",
